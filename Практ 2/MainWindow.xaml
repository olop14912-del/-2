<Window x:Class="Практ_2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Практическая работа №2. Вариант 13"
        Height="500" Width="850">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Menu Grid.Row="0">
            <MenuItem Header="Файл">
                <MenuItem Header="Открыть" Click="Open_Click"/>
                <MenuItem Header="Сохранить" Click="Save_Click"/>
                <Separator/>
                <MenuItem Header="Выход" Click="Exit_Click"/>
            </MenuItem>

            <MenuItem Header="Действия">
                <MenuItem Header="Создать" Click="Create_Click"/>
                <MenuItem Header="Заполнить" Click="Fill_Click"/>
                <MenuItem Header="Очистить" Click="Clear_Click"/>
                <MenuItem Header="Рассчитать" Click="Calc_Click"/>
            </MenuItem>

            <MenuItem Header="Справка">
                <MenuItem Header="О программе" Click="About_Click"/>
            </MenuItem>
        </Menu>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="5">
            <TextBlock Text="Строк:" VerticalAlignment="Center"/>
            <TextBox x:Name="tbRows" Text="3" Width="40" Margin="3"/>
            <TextBlock Text="Столбцов:" VerticalAlignment="Center"/>
            <TextBox x:Name="tbCols" Text="4" Width="40" Margin="3"/>
            <TextBlock Text="Диапазон 0.." VerticalAlignment="Center"/>
            <TextBox x:Name="tbMax" Text="20" Width="40" Margin="3"/>
            <Button Content="Создать" Width="80" Margin="10,0,0,0" Click="Create_Click"/>
            <Button Content="Заполнить" Width="80" Margin="5,0,0,0" Click="Fill_Click"/>
            <Button Content="Очистить" Width="80" Margin="5,0,0,0" Click="Clear_Click"/>
            <Button Content="Рассчитать" Width="90" Margin="5,0,0,0" Click="Calc_Click"/>
        </StackPanel>

        <Grid Grid.Row="2" Margin="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="260"/>
            </Grid.ColumnDefinitions>

            <GroupBox Header="Исходная матрица" Grid.Column="0" Margin="0,0,5,0">
                <DataGrid x:Name="dataGrid" AutoGenerateColumns="True" CanUserAddRows="False"/>
            </GroupBox>

            <GroupBox Header="Ответ" Grid.Column="1">
                <DataGrid x:Name="resultGrid" AutoGenerateColumns="True" IsReadOnly="True"/>
            </GroupBox>
        </Grid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="5">
            <Button Content="О программе" Width="110" Click="About_Click"/>
            <Button Content="Выход" Width="110" Margin="5,0,0,0" Click="Exit_Click"/>
        </StackPanel>
    </Grid>
</Window>